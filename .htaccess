# Always revalidate HTML so new deploys show immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|svg|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
